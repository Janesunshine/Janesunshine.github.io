# Ignore the contents of the _site directory and other cache directories
_site/
.sass-cache/
.jekyll-cache/

# Ignore the directory for local files during development
local/

# Ignore the Gemfile that is generated
Gemfile.lock

# Ingore files created by npm
node_modules
package-lock.json
.DS_Store

# Local Ruby gem install used for this project only (not committed —
# GitHub Pages builds server-side with its own pinned gem stack)
vendor/
.bundle/

# Stray R history file, not part of the site
_pages/.Rhistory
